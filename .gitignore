.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Databases & Prisma
*.db
*.db-journal
/prisma/migrations/
/src/generated/prisma

# Logs and Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log

# OS Metadata
.DS_Store
Thumbs.db
*.pem

# Vercel & Deployments
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
.env*
